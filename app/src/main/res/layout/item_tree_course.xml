<?xml version="1.0" encoding="utf-8"?>
<!-- Một nhánh của cây: đường nối từ học kỳ xuống môn, chấm màu theo trạng thái, điểm chữ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="16dp">

    <com.appgiuaky.gpaplanner.components.curriculum.TreeLineView
        android:id="@+id/tree_line"
        android:layout_width="20dp"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/tree_dot"
        android:layout_width="10dp"
        android:layout_height="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tree_course_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tree_course_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tree_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
