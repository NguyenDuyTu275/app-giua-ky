<?xml version="1.0" encoding="utf-8"?>
<!-- Bản đậm vừa cho tiêu đề và nhãn; chữ in đậm (textStyle="bold") vẫn dùng bản Bold -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute">
    <font
        android:font="@font/be_vietnam_pro_medium"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/be_vietnam_pro_medium"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/be_vietnam_pro_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/be_vietnam_pro_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
